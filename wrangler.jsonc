{
  // Cloudflare Pages project configuration
  // https://developers.cloudflare.com/pages/functions/wrangler-configuration/
  "name": "drkingbd-cc",
  "pages_build_output_dir": ".",
  "compatibility_date": "2024-09-23",

  "kv_namespaces": [
    {
      // Bind KV namespace for storing suggestion forum data.
      // After deploying, create a KV namespace in the Cloudflare Dashboard
      // and paste its ID here (and a preview ID for local dev).
      // CLI: wrangler kv namespace create SUGGESTIONS
      "binding": "SUGGESTIONS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_YOUR_PREVIEW_KV_NAMESPACE_ID"
    }
  ]
}
